{
  "name": "nebula-arena",
  "version": "1.0.0",
  "description": "星云竞技场 - 多人实时联机竞技H5游戏",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:game-server dev:api-server dev:match-server",
    "dev:client": "npm --workspace=@nebula/client run dev",
    "dev:game-server": "npm --workspace=@nebula/game-server run dev",
    "dev:match-server": "npm --workspace=@nebula/match-server run dev",
    "dev:api-server": "npm --workspace=@nebula/api-server run dev",
    "dev:admin-server": "npm --workspace=@nebula/admin-server run dev",
    "dev:admin-client": "npm --workspace=@nebula/admin-client run dev",
    "dev:log-server": "npm --workspace=@nebula/log-server run dev",
    "dev:all": "npm-run-all --parallel dev:client dev:game-server dev:api-server dev:match-server dev:admin-server dev:admin-client dev:log-server",
    "build": "npm --workspace=@nebula/shared run build && npm --workspaces run build",
    "start:game-server": "npm --workspace=@nebula/game-server run start",
    "start:match-server": "npm --workspace=@nebula/match-server run start",
    "start:api-server": "npm --workspace=@nebula/api-server run start",
    "start:admin-server": "npm --workspace=@nebula/admin-server run start",
    "start:log-server": "npm --workspace=@nebula/log-server run start"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
